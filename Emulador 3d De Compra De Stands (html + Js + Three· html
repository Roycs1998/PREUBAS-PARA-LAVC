<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Emulador 3D de Stands – Compra y Subasta</title>
  <style>
    :root{
      --bg:#0f1115;--panel:#151924;--muted:#9aa4b2;--text:#e6e9ef;--accent:#6ae3ff;--ok:#20c997;--warn:#f4bf4f;--bad:#ff6b6b;--auction:#c084fc;
    }
    html,body{height:100%;margin:0;background:var(--bg);color:var(--text);font-family:Inter,system-ui,Segoe UI,Roboto,Arial,sans-serif;}
    #app{display:grid;grid-template-columns:1fr 360px;height:100vh;gap:0;border-left:1px solid #222;}
    #canvas-wrap{position:relative;background:linear-gradient(#0c0f16,#0b0e14);}    
    #ui{background:var(--panel);border-left:1px solid #222;display:flex;flex-direction:column}
    header{padding:16px 16px;border-bottom:1px solid #222;display:flex;align-items:center;gap:10px}
    header h1{font-size:16px;margin:0;letter-spacing:.3px}
    header .badge{font-size:11px;padding:3px 8px;border-radius:999px;background:#0d253a;color:var(--accent);border:1px solid #113046}
    .toolbar{display:flex;gap:8px;margin-left:auto}
    .btn{border:1px solid #2a2f3a;background:#171b26;color:#e6e9ef;border-radius:10px;padding:8px 10px;font-size:12px;cursor:pointer}
    .btn:hover{filter:brightness(1.1)}
    .btn-primary{background:linear-gradient(180deg,#2c7be5,#1d5cc3);border-color:#2656a5}
    .btn-ghost{background:transparent;border-color:#2a2f3a}

    .panel{padding:16px;overflow:auto}
    .meta{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:8px}
    .kv{background:#0f1320;border:1px solid #1b2231;border-radius:10px;padding:10px}
    .kv label{display:block;color:var(--muted);font-size:11px;margin-bottom:6px}
    .kv div{font-weight:600}
    .legend{display:flex;flex-wrap:wrap;gap:8px;margin:8px 0}
    .pill{display:inline-flex;align-items:center;gap:6px;border:1px solid #2a2f3a;padding:6px 8px;border-radius:999px;font-size:11px}
    .dot{width:10px;height:10px;border-radius:50%}

    .section{margin:12px 0 6px;font-weight:700;font-size:12px;text-transform:uppercase;letter-spacing:.08em;color:#9fb0ff}
    .hint{font-size:12px;color:var(--muted)}

    .actions{display:grid;gap:8px;margin-top:10px}
    .buy{background:linear-gradient(180deg,#20c997,#139a74);border-color:#107a5d}
    .auction{background:linear-gradient(180deg,#c084fc,#8b5cf6);border-color:#7c3aed}
    .disabled{opacity:.5;pointer-events:none}

    /* Toast */
    #toast{position:absolute;inset:auto 16px 16px auto;background:#111826;border:1px solid #273043;padding:10px 14px;border-radius:10px;display:none;box-shadow:0 10px 30px rgba(0,0,0,.35);}

    /* Overlay modal */
    .overlay{position:fixed;inset:0;background:rgba(0,0,0,.5);display:none;align-items:center;justify-content:center;z-index:20}
    .modal{width:min(520px,92vw);background:#0f1320;border:1px solid #243047;border-radius:16px;overflow:hidden;}
    .modal header{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #1b2438}
    .modal .content{padding:16px}
    .row{display:grid;grid-template-columns:140px 1fr;gap:10px;margin:10px 0}
    input,select{background:#0c111b;border:1px solid #1e2635;color:#f0f3f7;border-radius:10px;padding:10px}
    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}

    /* Tooltip label over 3D */
    .label{font-size:12px;color:#fff;background:rgba(0,0,0,.55);padding:3px 6px;border-radius:6px;border:1px solid rgba(255,255,255,.15);pointer-events:none;}

    /* Mobile */
    @media (max-width: 980px){
      #app{grid-template-columns:1fr;}
      #ui{position:absolute;inset:auto 12px 12px 12px;border:1px solid #222;border-radius:16px;background:rgba(21,25,36,.9);backdrop-filter: blur(6px)}
      header{padding:10px}
      .panel{max-height:42vh}
    }
  </style>
</head>
<body>
<div id="app">
  <div id="canvas-wrap">
    <canvas id="c"></canvas>
    <div id="toast"></div>
  </div>
  <aside id="ui">
    <header>
      <h1>Mapa 3D de Stands</h1>
      <span class="badge">Demo</span>
      <div class="toolbar">
        <button class="btn btn-ghost" id="resetBtn">Reiniciar</button>
        <button class="btn btn-primary" id="saveBtn">Guardar</button>
      </div>
    </header>
    <div class="panel">
      <div class="section">Leyenda</div>
      <div class="legend">
        <span class="pill"><span class="dot" style="background: var(--ok)"></span>Disponible</span>
        <span class="pill"><span class="dot" style="background: var(--warn)"></span>Reservado</span>
        <span class="pill"><span class="dot" style="background: var(--bad)"></span>Vendido</span>
        <span class="pill"><span class="dot" style="background: var(--auction)"></span>Subasta</span>
      </div>

      <div class="section">Stand seleccionado</div>
      <div class="meta" id="standMeta">
        <div class="kv"><label>ID</label><div id="kvId">—</div></div>
        <div class="kv"><label>Estado</label><div id="kvEstado">—</div></div>
        <div class="kv"><label>Precio</label><div id="kvPrecio">—</div></div>
        <div class="kv"><label>Tamaño</label><div id="kvTam">—</div></div>
      </div>
      <p class="hint">Consejo: usa el mouse para orbitar (botón izquierdo), panear (derecho) y hacer zoom.
      Haz click sobre un stand para ver opciones.</p>
      <div class="actions">
        <button id="buyBtn" class="btn buy disabled">Comprar</button>
        <button id="auctionBtn" class="btn auction disabled">Unirse a subasta</button>
      </div>

      <div class="section">Filtros rápidos</div>
      <div class="grid">
        <button class="btn" data-filter="all">Todos</button>
        <button class="btn" data-filter="available">Disponibles</button>
        <button class="btn" data-filter="auction">Subasta</button>
      </div>
    </div>
  </aside>
</div>

<!-- Modal Compra -->
<div class="overlay" id="modalCompra">
  <div class="modal">
    <header>
      <h3 style="margin:0;font-size:14px">Confirmar compra</h3>
      <button class="btn btn-ghost" onclick="closeModal('modalCompra')">Cerrar</button>
    </header>
    <div class="content">
      <div class="row"><strong>Stand:</strong> <span id="mcId">—</span></div>
      <div class="row"><strong>Precio:</strong> <span id="mcPrecio">—</span></div>
      <div class="row"><label>Nombre / Empresa</label><input id="mcName" placeholder="Tu nombre o empresa" /></div>
      <div class="row"><label>Email</label><input id="mcMail" placeholder="tucorreo@dominio.com" /></div>
      <div style="display:flex;gap:8px;justify-content:flex-end;margin-top:4px">
        <button class="btn" onclick="closeModal('modalCompra')">Cancelar</button>
        <button class="btn buy" id="mcConfirm">Pagar (simulado)</button>
      </div>
    </div>
  </div>
</div>

<!-- Modal Subasta -->
<div class="overlay" id="modalSubasta">
  <div class="modal">
    <header>
      <h3 style="margin:0;font-size:14px">Subasta en vivo</h3>
      <button class="btn btn-ghost" onclick="closeModal('modalSubasta')">Cerrar</button>
    </header>
    <div class="content">
      <div class="row"><strong>Stand:</strong> <span id="sbId">—</span></div>
      <div class="row"><strong>Precio base:</strong> <span id="sbBase">—</span></div>
      <div class="row"><strong>Tiempo restante:</strong> <span id="sbTimer">—</span></div>
      <div class="row"><label>Mi oferta</label>
        <input id="sbBid" type="number" min="0" step="1" placeholder="Monto" />
      </div>
      <div style="display:flex;gap:8px;justify-content:flex-end;margin-top:4px">
        <button class="btn" onclick="closeModal('modalSubasta')">Cancelar</button>
        <button class="btn auction" id="sbOffer">Ofertar</button>
      </div>
      <div class="section">Ofertas</div>
      <div id="sbLog" class="kv" style="max-height:200px;overflow:auto"></div>
    </div>
  </div>
</div>

<script src="https://unpkg.com/three@0.160.0/build/three.min.js"></script>
<script src="https://unpkg.com/three@0.160.0/examples/js/controls/OrbitControls.js"></script>
<script src="https://unpkg.com/three@0.160.0/examples/js/renderers/CSS2DRenderer.js"></script>
<script>
(() => {
  // ===== Utiles UI =====
  const $ = (sel) => document.querySelector(sel);
  const $$ = (sel) => Array.from(document.querySelectorAll(sel));
  const toast = (msg) => { const t=$('#toast'); t.textContent=msg; t.style.display='block'; clearTimeout(t._to); t._to=setTimeout(()=>t.style.display='none',2400) };
  window.closeModal = (id) => { document.getElementById(id).style.display='none'; };
  const openModal = (id) => { document.getElementById(id).style.display='flex'; };
  const fmt = (n) => new Intl.NumberFormat('es-PE',{style:'currency',currency:'PEN',maximumFractionDigits:0}).format(n);

  // ===== Estados =====
  const STATUS = { AVAILABLE:'Disponible', RESERVED:'Reservado', SOLD:'Vendido', AUCTION:'Subasta' };
  const COLOR = { Available:0x18c29c, Reserved:0xf4bf4f, Sold:0xff6b6b, Auction:0xc084fc };

  // Persistencia simple
  const STORAGE_KEY = 'expo-stands-v1';
  const saveState = (state) => localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
  const loadState = () => { try{ return JSON.parse(localStorage.getItem(STORAGE_KEY))||null }catch{ return null } };

  // ===== Three.js setup =====
  const canvas = document.getElementById('c');
  const renderer = new THREE.WebGLRenderer({canvas, antialias:true});
  renderer.setPixelRatio(Math.min(devicePixelRatio,2));
  const scene = new THREE.Scene();
  scene.background = new THREE.Color(0x0c0f16);

  const camera = new THREE.PerspectiveCamera(55, 1, 0.1, 2000);
  camera.position.set(80, 80, 120);
  scene.add(camera);

  const controls = new THREE.OrbitControls(camera, renderer.domElement);
  controls.enableDamping = true; controls.dampingFactor=.06; controls.minDistance=30; controls.maxDistance=400; controls.maxPolarAngle = Math.PI*0.49;

  // Luz
  const hemi = new THREE.HemisphereLight(0xffffff,0x222233, 0.8); scene.add(hemi);
  const dir = new THREE.DirectionalLight(0xffffff, 0.9); dir.position.set(50,100,30); dir.castShadow=true; scene.add(dir);

  // Piso del pabellón
  const floorGeo = new THREE.PlaneGeometry(240, 160, 1, 1);
  const floorMat = new THREE.MeshStandardMaterial({color:0x111827, metalness:.1, roughness:.9});
  const floor = new THREE.Mesh(floorGeo, floorMat); floor.rotation.x = -Math.PI/2; floor.receiveShadow=true; scene.add(floor);

  // Grid suave
  const grid = new THREE.GridHelper(240, 24, 0x233044, 0x1a2233); grid.position.y = 0.01; scene.add(grid);

  // Label renderer (para ID sobre cada stand)
  const labelRenderer = new THREE.CSS2DRenderer();
  labelRenderer.setSize(300, 150);
  labelRenderer.domElement.style.position='absolute';
  labelRenderer.domElement.style.top='0';
  labelRenderer.domElement.style.pointerEvents='none';
  document.getElementById('canvas-wrap').appendChild(labelRenderer.domElement);

  // ===== Crear stands =====
  const hall = { width: 220, depth: 140 };
  const stands = []; // [{id,x,z,w,d,h,price,status,isAuction,mesh,label}]

  function layoutStands(){
    const rows = 6; const cols = 10; // 60 stands
    const margin = 6; const w = (hall.width - (cols+1)*margin)/cols; const d = (hall.depth - (rows+1)*margin)/rows;
    let id=1; const y=2.5;
    for(let r=0;r<rows;r++){
      for(let c=0;c<cols;c++){
        const sx = -hall.width/2 + margin + c*(w+margin) + w/2;
        const sz = -hall.depth/2 + margin + r*(d+margin) + d/2;
        const h = 5 + Math.random()*2;
        const price = 2500 + Math.round((rows-r)*200 + Math.random()*400);
        const isAuction = Math.random()<0.18; // ~18% a subasta
        const status = isAuction? STATUS.AUCTION : STATUS.AVAILABLE;
        createStand({ id:id++, x:sx, z:sz, w, d, h, price, status, isAuction });
      }
    }
  }

  const standMat = new THREE.MeshStandardMaterial({color: COLOR.Available, metalness:.2, roughness:.6});
  function createStand(s){
    const geo = new THREE.BoxGeometry(s.w, s.h, s.d);
    const mesh = new THREE.Mesh(geo, standMat.clone());
    mesh.position.set(s.x, s.h/2, s.z);
    mesh.castShadow = true; mesh.userData.type='stand';

    // color por estado
    setStandColor(mesh, s.status);

    // Borde superior
    const edge = new THREE.Mesh(new THREE.BoxGeometry(s.w*1.005, 0.2, s.d*1.005), new THREE.MeshStandardMaterial({color:0x0a0d14, metalness:.1, roughness:.8}));
    edge.position.y = s.h + 0.11; mesh.add(edge);

    // Label CSS
    const div = document.createElement('div'); div.className='label'; div.textContent = `#${s.id}`;
    const label = new THREE.CSS2DObject(div); label.position.set(0, s.h+0.8, 0); mesh.add(label);

    const item = {...s, mesh, label};
    stands.push(item); scene.add(mesh);
  }

  function setStandColor(mesh, status){
    const c = status===STATUS.AVAILABLE? COLOR.Available : status===STATUS.AUCTION? COLOR.Auction : status===STATUS.RESERVED? COLOR.Reserved : COLOR.Sold;
    mesh.material.color.setHex(c);
  }

  // Cargar estado guardado (si existe) antes del layout
  const saved = loadState();
  layoutStands();
  if(saved && Array.isArray(saved.stands)){
    for(const snap of saved.stands){
      const item = stands.find(s=>s.id===snap.id);
      if(!item) continue;
      item.status = snap.status; item.price = snap.price; item.isAuction = snap.isAuction; item.auction = snap.auction||null;
      setStandColor(item.mesh, item.status);
    }
  }

  // ===== Interacción =====
  const raycaster = new THREE.Raycaster(); const mouse = new THREE.Vector2();
  let hovered = null; let selected = null;

  function onResize(){
    const wrap = document.getElementById('canvas-wrap');
    const {clientWidth:w, clientHeight:h} = wrap; renderer.setSize(w,h,false); labelRenderer.setSize(w,h); camera.aspect = w/h; camera.updateProjectionMatrix();
  }
  window.addEventListener('resize', onResize); onResize();

  function pick(mx,my){
    const rect = renderer.domElement.getBoundingClientRect();
    mouse.x = ((mx-rect.left)/rect.width)*2 - 1; mouse.y = -((my-rect.top)/rect.height)*2 + 1;
    raycaster.setFromCamera(mouse, camera);
    const intersects = raycaster.intersectObjects(stands.map(s=>s.mesh));
    return intersects[0]?.object || null;
  }

  canvas.addEventListener('mousemove', (e)=>{
    const hit = pick(e.clientX,e.clientY);
    if(hit!==hovered){
      if(hovered){ hovered.scale.set(1,1,1); hovered.material.emissive?.setHex(0x000000) }
      hovered = hit; if(hovered){ hovered.scale.set(1.03,1.03,1.03); hovered.material.emissive?.setHex(0x0a0f18) }
    }
  });

  canvas.addEventListener('click', (e)=>{
    const hit = pick(e.clientX,e.clientY);
    if(hit){
      selected = stands.find(s=>s.mesh===hit);
      updateSelectedUI();
    }
  });

  function updateSelectedUI(){
    const idEl = document.getElementById('kvId');
    const esEl = document.getElementById('kvEstado');
    const prEl = document.getElementById('kvPrecio');
    const tmEl = document.getElementById('kvTam');
    const buyBtn = document.getElementById('buyBtn');
    const auctionBtn = document.getElementById('auctionBtn');

    if(!selected){
      idEl.textContent=esEl.textContent=prEl.textContent=tmEl.textContent='—';
      buyBtn.classList.add('disabled'); auctionBtn.classList.add('disabled');
      return;
    }
    idEl.textContent = `#${selected.id}`;
    esEl.textContent = selected.status;
    prEl.textContent = fmt(selected.price);
    tmEl.textContent = `${selected.w.toFixed(1)}m × ${selected.d.toFixed(1)}m`;

    const canBuy = selected.status===STATUS.AVAILABLE;
    const canAuction = selected.status===STATUS.AUCTION;
    buyBtn.classList.toggle('disabled', !canBuy);
    auctionBtn.classList.toggle('disabled', !canAuction);

    // Completar datos modales
    document.getElementById('mcId').textContent = `#${selected.id}`;
    document.getElementById('mcPrecio').textContent = fmt(selected.price);
    document.getElementById('sbId').textContent = `#${selected.id}`;
    document.getElementById('sbBase').textContent = fmt(selected.price);
  }

  // ===== Filtros =====
  $$('.grid .btn').forEach(b=>b.addEventListener('click',()=>{
    const f = b.dataset.filter;
    for(const s of stands){
      const show = (f==='all') || (f==='available' && s.status===STATUS.AVAILABLE) || (f==='auction' && s.status===STATUS.AUCTION);
      s.mesh.visible = show;
      s.label.element.style.display = show? 'block':'none';
    }
  }));

  // ===== Comprar (simulado) =====
  document.getElementById('buyBtn').addEventListener('click',()=>{ if(!selected) return; openModal('modalCompra'); });
  document.getElementById('mcConfirm').addEventListener('click',()=>{
    const name = document.getElementById('mcName').value.trim();
    const mail = document.getElementById('mcMail').value.trim();
    if(!name||!mail){ toast('Completa nombre y correo.'); return; }
    selected.status = STATUS.SOLD; setStandColor(selected.mesh, selected.status); updateSelectedUI(); saveSnapshot(); closeModal('modalCompra'); toast(`¡Compra realizada! Stand #${selected.id} marcado como vendido.`);
  });

  // ===== Subasta (simulada) =====
  let auctionTimer = null;
  function resetAuctionTimer(){ if(auctionTimer){ clearInterval(auctionTimer); auctionTimer=null; } }

  function ensureAuctionState(s){
    if(!s.auction){
      const endAt = Date.now() + (1000*60*2 + Math.floor(Math.random()*30000)); // ~2 min
      s.auction = { endAt, top: s.price, bids: [] };
    }
  }
  function renderAuctionState(s){
    if(!s || !s.auction) return; const log = document.getElementById('sbLog');
    log.innerHTML = `<div><strong>Mejor oferta:</strong> ${fmt(s.auction.top)}</div>` +
      s.auction.bids.slice().reverse().map(b=>`<div style="margin-top:6px">${new Date(b.t).toLocaleTimeString()} — <strong>${fmt(b.v)}</strong> por ${b.n}</div>`).join('');
  }
  function startAuctionCountdown(s){
    const el = document.getElementById('sbTimer');
    resetAuctionTimer();
    auctionTimer = setInterval(()=>{
      const rem = Math.max(0, s.auction.endAt - Date.now());
      const m = Math.floor(rem/60000), sec = Math.floor((rem%60000)/1000);
      el.textContent = `${m}:${sec.toString().padStart(2,'0')}`;
      if(rem<=0){
        clearInterval(auctionTimer); auctionTimer=null;
        // adjudicar si hubo pujas
        if(s.auction.bids.length){ s.status = STATUS.SOLD; setStandColor(s.mesh, s.status); toast(`Subasta terminada. Stand #${s.id} adjudicado en ${fmt(s.auction.top)}.`) }
        else { toast('Subasta terminada sin ofertas.'); }
        saveSnapshot(); updateSelectedUI(); closeModal('modalSubasta');
      }
    },300);
  }

  document.getElementById('auctionBtn').addEventListener('click',()=>{
    if(!selected) return; ensureAuctionState(selected); renderAuctionState(selected); startAuctionCountdown(selected); openModal('modalSubasta');
  });
  document.getElementById('sbOffer').addEventListener('click',()=>{
    const me = (document.getElementById('mcName').value.trim()||'Anónimo');
    const val = parseFloat(document.getElementById('sbBid').value);
    if(!selected || !selected.auction) return;
    if(!isFinite(val) || val <= selected.auction.top){ toast('La oferta debe superar la actual.'); return; }
    selected.auction.top = val; selected.auction.bids.push({v:val, n:me, t:Date.now()});
    renderAuctionState(selected); toast('Oferta registrada ✅'); saveSnapshot();
  });

  // ===== Guardado / reset =====
  function saveSnapshot(){
    const snap = { stands: stands.map(s=>({id:s.id, price:s.price, status:s.status, isAuction:s.isAuction, auction:s.auction||null})) };
    saveState(snap);
  }
  document.getElementById('saveBtn').addEventListener('click',()=>{ saveSnapshot(); toast('Estado guardado en este navegador.'); });
  document.getElementById('resetBtn').addEventListener('click',()=>{
    localStorage.removeItem(STORAGE_KEY); location.reload();
  });

  // ===== Animación =====
  function tick(){ controls.update(); renderer.render(scene, camera); labelRenderer.render(scene, camera); requestAnimationFrame(tick); }
  tick();
})();
</script>
</body>
</html>
